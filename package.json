{
  "name": "qqpilot-dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "QQPilot 连接 DeepSeek Harness: OpenAI Chat-Completion 兼容端口 让 DSH 选择是否与如何回复消息, 具有工具调用功能 (reply / stay silent / send images) 附带兼容模式，适用入门级设备运行的本地模型（1B~9B)",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon2.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon2.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
